# Builds and inputs under test, resolved 2026-10-09 from upstream tags and branches.
# Every run records these values plus binary SHA-256s in its provenance directory.

# Zaino: latest stable release (stable branch, 2026-09-29). Built on Zebra 6.3.0 crates.
ZAINO_STABLE_REF=0.10.1
ZAINO_STABLE_COMMIT=3244a74bb09fa6a09a4b2deeb6be53bab0890747
# Zaino: the build Ztreamer's published 2026-09-11 comparison measured (commit d27ec93 == tag 0.9.0).
ZAINO_REPRO_REF=0.9.0
ZAINO_REPRO_COMMIT=d27ec9303858d0216367f5469e37364a4f34ee2c
# Default feature set plus the metrics endpoint. Transparent address history stays at its default (off).
ZAINO_FEATURES=prometheus

# Ztreamer: latest tag. Embeds the Zakura fork distractedm1nd/zakura@f4d44dd (state DB format 28.1.5).
ZTREAMER_RELEASE_REF=v0.1.0
ZTREAMER_RELEASE_COMMIT=c40f3c31d8fb3f850c3fa90d9490b4df50aa88c4
# Ztreamer: master, which the README's `cargo install --git` installs. Embeds Zakura v1.5.1 (format 29.1.0).
ZTREAMER_HEAD_REF=master
ZTREAMER_HEAD_COMMIT=6232ae08e6c74baced3905c08564a9c90a816bfc

# Zebra: current mainnet release (6.4.0 and 6.4.1 are under advisory GHSA-h5rr-8pqv-grp9).
# State DB format 28.0.0, the same major version Zaino 0.9.0 and 0.10.1 read in `direct` mode.
ZEBRA_REF=v6.4.2
ZEBRA_COMMIT=e3eef2f37c35127ad1769f19a1ebc7eaa5d5d291
ZEBRA_FEATURES=indexer

# Zakura archive snapshots (manifest: https://zakura.valargroup.dev/mainnet/snapshots.json).
# v28 opens with Ztreamer v0.1.0; v29 was produced by Zakura 1.5.1, the version Ztreamer master pins.
SNAP_BASE_URL=https://zakura.valargroup.dev/mainnet
SNAP_V28_FILE=zakura-mainnet-20260901T140815Z-3468265.tar.zst
SNAP_V28_SHA256=f5ec1ce093527b82fd4c5ea549f0e566428d9bc009829629a98a458da349cc75
SNAP_V29_FILE=zakura-mainnet-20261001T000750Z-3502001.tar.zst
SNAP_V29_SHA256=41c1287811a486bd5701268a28eb97fe686bdccc1073e1f3b1527c5304b8c335

# Zcash Foundation Zebra state snapshots (https://snapshots.zfnd.org), format 28.0.0, cut by zebrad 6.3.0.
# The testnet one predates testnet's NU7 activation (4,465,026), so every build follows the same rules.
ZF_TESTNET_URL=https://snapshots.zfnd.org/testnet/20260923/zebrad-state-testnet-v28-20260923.tar.zst
ZF_TESTNET_SHA256=e1702bb220a337f94496e1f65b683b63f22334fdc500c5421dd118e593358636
ZF_TESTNET_HEIGHT=4383897

# Load-generation and inspection tools.
GHZ_VERSION=v0.121.0
GRPCURL_VERSION=1.9.4

# Layout and network; each can be overridden from the environment (CI sets DATA, OPT and NETWORK).
NETWORK=${NETWORK:-Mainnet}
DATA=${DATA:-/data}
OPT=${OPT:-/opt/zbench}

# Loopback ports. Nothing under test listens on a public interface.
ZEBRA_RPC=127.0.0.1:8232
ZEBRA_INDEXER_RPC=127.0.0.1:8230
ZEBRA_METRICS=127.0.0.1:9101
ZAINO_GRPC=127.0.0.1:8137
ZAINO_JSONRPC=127.0.0.1:8237
ZAINO_METRICS=127.0.0.1:19998
ZTREAMER_GRPC=127.0.0.1:9067
ZTREAMER_METRICS=127.0.0.1:9999
